# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit your real settings (tokens, IPs, etc).

# required: needs your TZ for correct time, e.g. Europe/Berlin
TZ=YOUR_TIMEZONE

# required: 1 or more network interfaces, space separated, e.g. "eth0" or "eth0 wlan0"
IFACES=YOUR_IFACE

# optional: custom DNS server for the container (e.g. a local Pi-hole/router), only used
# if you uncomment the 'dns:' block in docker-compose.yml
DNS_IP=

# optional, default: 0.0.0.0
HOST=0.0.0.0

# optional, default: 8840
PORT=8840

# optional, time in seconds, default: 120
TIMEOUT=120

# optional, set url to notify (Shoutrrr format, e.g. telegram://TOKEN@telegram?chats=CHAT_ID)
SHOUTRRR_URL=

# optional, legacy Bootswatch theme name (used until Bootstrap is fully removed)
THEME=cyborg

# optional: light | dark | system
COLOR=system

# --- only used by docker-compose-auth.yml (ForAuth) ---

# required: watchyourlan runs in host network mode, so forauth reaches it via the
# host's real IP or DNS name, not the Docker service name
WYL_HOST_IP=YOUR_SERVER_IP

# optional: ForAuth login username, default: user
FA_AUTH_USER=user

# bcrypt hash of your ForAuth password, no '$$' escaping needed here (see docker-compose-auth.yml)
# how-to: https://github.com/aceberg/ForAuth/blob/main/docs/BCRYPT.md
FA_AUTH_PASSWORD=
